# ─────────────────────────────────────────────────────────────────────────────
# Contingency Deadline Copilot — Environment Variables
# Copy this file to backend/.env and fill in real values.
# Add NEXT_PUBLIC_* vars to frontend/.env.local
# NEVER commit .env files with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL via Prisma) ──────────────────────────
# Local Docker:   postgresql://copilot:copilot@localhost:5432/copilot_dev
# Remote (Neon/Railway/Supabase): paste connection string here
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot_dev

# ── File Storage ──────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# AWS S3 / Cloudflare R2 (production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# ── AI / Gemini ───────────────────────────────────────────────
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-3.6-flash

# ── Alerts — Twilio SMS ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Alerts — Email (SendGrid or AWS SES) ─────────────────────
EMAIL_DRIVER=sendgrid
SENDGRID_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# ── Inbound Email Parse ───────────────────────────────────────
INBOUND_PARSE_SECRET=

# ── Payments — Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Frontend (Next.js public vars) — add to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3001/api
