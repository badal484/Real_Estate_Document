// Contingency Deadline Copilot — Prisma Schema
// Database: PostgreSQL 16
// Run: npx prisma db push  (dev)  |  npx prisma migrate deploy  (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization / Multi-Tenancy Boundary ────────────────────────────────────
model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  leads       Lead[]
  properties  Property[]
  deals       Deal[]
  kbDocuments KBDocument[]

  @@map("organizations")
}

// ─── User ─────────────────────────────────────────────────────────────────────
// An agent who signs in with Google.
model User {
  id             String        @id @default(cuid())
  googleId       String        @unique
  email          String        @unique
  name           String?
  pictureUrl     String?
  organizationId String?
  lastLoginAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  assignedLeads Lead[]

  @@map("users")
}

// ─── Lead & Lead Requirements ────────────────────────────────────────────────
model Lead {
  id             String       @id @default(cuid())
  organizationId String?
  source         LeadSource   @default(WEBSITE_FORM)
  externalId     String?      @unique
  fullName       String
  email          String?
  phone          String?
  status         LeadStatus   @default(NEW)
  priority       LeadPriority @default(MEDIUM)
  assignedUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization?        @relation(fields: [organizationId], references: [id])
  assignedUser  User?                @relation(fields: [assignedUserId], references: [id])
  requirements  LeadRequirement?
  conversations ConversationThread[]
  matches       PropertyMatch[]
  deals         Deal[]

  @@index([organizationId, status])
  @@index([email, phone])
  @@map("leads")
}

enum LeadSource {
  WEBSITE_FORM
  PORTAL_INQUIRY
  WHATSAPP
  EMAIL
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model LeadRequirement {
  id                 String   @id @default(cuid())
  leadId             String   @unique
  minBudget          Float?
  maxBudget          Float?
  preferredLocations String[]
  propertyType       String?
  minBedrooms        Int?
  maxBedrooms        Int?
  possessionTimeline String?
  notes              String?  @db.Text
  rawAiExtraction    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_requirements")
}

// ─── Multi-Channel Conversation & Human Takeover ────────────────────────────
model ConversationThread {
  id               String               @id @default(cuid())
  leadId           String
  channel          MessageChannel       @default(EMAIL)
  isHumanTakeover  Boolean              @default(false)
  takeoverBy       String?
  autoReplyEnabled Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  lead     Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([leadId])
  @@map("conversation_threads")
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SMS
  WEB_CHAT
}

model ConversationMessage {
  id              String         @id @default(cuid())
  threadId        String
  senderType      SenderType
  senderId        String?
  content         String         @db.Text
  suggestedAction Json?
  approvalStatus  ApprovalStatus @default(APPROVED)
  createdAt       DateTime       @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("conversation_messages")
}

enum SenderType {
  CUSTOMER
  AGENT
  AI
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EDITED
}

// ─── Property Inventory & Matching ──────────────────────────────────────────
model Property {
  id             String         @id @default(cuid())
  organizationId String?
  title          String
  address        String
  city           String
  price          Float
  bedrooms       Int
  bathrooms      Float
  propertyType   String
  status         PropertyStatus @default(AVAILABLE)
  possessionDate DateTime?
  features       String[]
  description    String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization?   @relation(fields: [organizationId], references: [id])
  matches      PropertyMatch[]

  @@index([organizationId, price, bedrooms, status])
  @@map("properties")
}

enum PropertyStatus {
  AVAILABLE
  UNDER_CONTRACT
  SOLD
  OFF_MARKET
}

model PropertyMatch {
  id             String   @id @default(cuid())
  leadId         String
  propertyId     String
  matchScore     Float
  matchReason    String   @db.Text
  failedCriteria String[]
  createdAt      DateTime @default(now())

  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([leadId, propertyId])
  @@map("property_matches")
}

// ─── Transaction Tasks & Milestone Obligations ──────────────────────────────
model TransactionTask {
  id               String     @id @default(cuid())
  dealId           String
  title            String
  description      String?    @db.Text
  dueDate          DateTime
  amount           Float?
  assignedTo       String?
  isHumanReviewed  Boolean    @default(false)
  status           TaskStatus @default(PENDING)
  sourceDocumentId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, status])
  @@map("transaction_tasks")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

// ─── Knowledge Base Documents ────────────────────────────────────────────────
model KBDocument {
  id             String      @id @default(cuid())
  organizationId String?
  title          String
  category       String
  storagePath    String
  indexStatus    IndexStatus @default(PENDING)
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("kb_documents")
}

// ─── Deal ─────────────────────────────────────────────────────────────────────
// One Deal = one purchase agreement (one contract file).
model Deal {
  id               String      @id @default(cuid())
  organizationId   String?
  leadId           String?
  propertyAddress  String
  buyerName        String?
  sellerName       String?
  acceptanceDate   DateTime?   // Contract acceptance / effective date
  status           DealStatus  @default(ACTIVE)
  timezone         String      @default("America/New_York") // [Person A]
  inboundAlias     String?     @unique                      // [Person A] e.g. "deal-abc123"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization         Organization?           @relation(fields: [organizationId], references: [id])
  lead                 Lead?                   @relation(fields: [leadId], references: [id])
  documents            Document[]
  clauses              ContingencyClause[]
  deadlines            Deadline[]
  tasks                TransactionTask[]
  auditLogs            AuditLog[]
  chunks               DocumentChunk[]         // [Person B]
  conversations        AssistantConversation[] // [Person B]
  notificationSettings NotificationSetting?   // [Person A]
  emailLogs            EmailLog[]              // [Person A]

  @@map("deals")
}

enum DealStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

// ─── Document ─────────────────────────────────────────────────────────────────
// Uploaded PDF (or future: other doc types).
model Document {
  id            String         @id @default(cuid())
  dealId        String
  filename      String                     // original filename
  storagePath   String                     // local path or S3/ImageKit key
  mimeType      String         @default("application/pdf")
  sizeBytes     Int?
  docType       DocType        @default(OTHER)      // [Person B]
  effectiveDate DateTime?                           // [Person B]
  pageCount     Int?                                // [Person B]
  indexStatus   IndexStatus    @default(PENDING)    // [Person B] PENDING | INDEXING | READY | FAILED
  indexedAt     DateTime?                           // [Person B]
  uploadedAt    DateTime       @default(now())

  deal    Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clauses ContingencyClause[]
  chunks  DocumentChunk[]     // [Person B]

  @@map("documents")
}

enum DocType {
  PURCHASE_AGREEMENT
  COUNTER_OFFER
  ADDENDUM
  INSPECTION_REPORT
  HOA_DISCLOSURE
  TITLE_COMMITMENT
  OTHER
}

enum IndexStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

// ─── DocumentChunk ────────────────────────────────────────────────────────────
// [Person B] Page-level & section-boundary chunks with spatial/text metadata for RAG
model DocumentChunk {
  id           String      @id @default(cuid())
  documentId   String
  dealId       String
  pageNumber   Int
  chunkIndex   Int
  sectionTitle String?
  content      String      @db.Text
  tokenCount   Int?
  source       ChunkSource @default(text) // text layer or ocr fallback
  embedding    Json?                      // Array of floats or pgvector compatibility
  createdAt    DateTime    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, documentId])
  @@index([dealId, pageNumber])
  @@map("document_chunks")
}

enum ChunkSource {
  text
  ocr
}

// ─── AssistantConversation & Messages ─────────────────────────────────────────
// [Person B] Conversation threads for the AI Knowledge Assistant
model AssistantConversation {
  id        String             @id @default(cuid())
  dealId    String
  userId    String?
  title     String             @default("New Conversation")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  deal     Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([dealId])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id                 String                @id @default(cuid())
  conversationId     String
  role               String                // "user" | "assistant"
  content            String                @db.Text
  citations          Json?                 // Array of Citation objects
  suggestedFollowUps Json?                 // Array of string follow-ups
  createdAt          DateTime              @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("assistant_messages")
}

// ─── NotificationSetting & EmailLog ───────────────────────────────────────────
// [Person A Block] Email alert configurations & audit logs
model NotificationSetting {
  id          String   @id @default(cuid())
  dealId      String   @unique
  recipients  Json     // string[] email addresses
  window3d    Boolean  @default(true)
  window1d    Boolean  @default(true)
  windowDayOf Boolean  @default(true)
  windowMissed Boolean @default(true)
  enabled     Boolean  @default(true)
  timezone    String   @default("America/New_York")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model EmailLog {
  id                 String      @id @default(cuid())
  dealId             String
  deadlineId         String?
  recipient          String
  template           String      // "3d" | "1d" | "dayOf" | "missed" | "summary" | "docs_received"
  status             EmailStatus @default(SENT) // SENT | DELIVERED | BOUNCED | DROPPED
  providerMessageId  String?
  errorMessage       String?
  sentAt             DateTime    @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([deadlineId, template])
  @@index([dealId])
  @@map("email_logs")
}

enum EmailStatus {
  SENT
  DELIVERED
  BOUNCED
  DROPPED
}

// ─── ContingencyClause ────────────────────────────────────────────────────────
// A single extracted contingency from the PDF, with source evidence.
model ContingencyClause {
  id           String      @id @default(cuid())
  dealId       String
  documentId   String
  clauseType   String      // e.g. "inspection", "financing", "appraisal"
  rawText      String      @db.Text // exact quoted text from PDF
  pageNumber   Int?
  boundingBox  Json?       // { x, y, width, height } for pdf.js highlight
  confidence   Float?      // 0.0–1.0 from AI extraction
  numberOfDays Int?        // parsed: "X days"
  dayType      DayType?    // calendar | business
  createdAt    DateTime    @default(now())

  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deadline  Deadline?

  @@map("contingency_clauses")
}

enum DayType {
  calendar
  business
}

// ─── Deadline ─────────────────────────────────────────────────────────────────
// A computed (then user-confirmed) deadline derived from a clause.
model Deadline {
  id             String         @id @default(cuid())
  dealId         String
  clauseId       String         @unique    // one clause → one deadline
  label          String                    // human-readable: "Inspection Contingency"
  computedDate   DateTime                  // calculated by date engine
  confirmedDate  DateTime?                 // set when user confirms or edits
  dayType        DayType        @default(calendar)
  status         DeadlineStatus @default(PENDING)
  confirmedBy    String?                   // user identifier (email or name)
  confirmedAt    DateTime?
  alertSentAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deal   Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clause ContingencyClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@map("deadlines")
}

enum DeadlineStatus {
  PENDING    // extracted, not yet confirmed by user
  CONFIRMED  // user confirmed the date
  ACTIVE     // confirmed + alerts scheduled
  MISSED     // past due date, not completed
  COMPLETED  // agent marked as done
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────
// Immutable log of every extraction, confirmation, edit, or alert event.
model AuditLog {
  id            String      @id @default(cuid())
  dealId        String?
  action        AuditAction
  entityType    String?     // "Deadline" | "ContingencyClause" | "Deal" | "Document" | "Assistant" | "Lead" | "Property" | "Task"
  entityId      String?
  previousValue Json?       // before-state snapshot
  newValue      Json?       // after-state snapshot
  actor         String?     // "system" | user email/name
  note          String?     // free-text annotation
  createdAt     DateTime    @default(now())

  deal Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

enum AuditAction {
  DOCUMENT_UPLOADED
  EXTRACTION_STARTED
  EXTRACTION_COMPLETED
  DEADLINE_CONFIRMED
  DEADLINE_EDITED
  DEADLINE_ACTIVATED
  ALERT_SENT
  DEAL_CREATED
  DEAL_UPDATED
  ASSISTANT_QUERY          // [Person B]
  DOCUMENT_INDEXED         // [Person B]
  EMAIL_SENT_TEST          // [Person A]
  EMAIL_INBOUND_RECEIVED   // [Person A]
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_REQUIREMENTS_EXTRACTED
  HUMAN_TAKEOVER_TOGGLED
  PROPERTY_CREATED
  PROPERTY_MATCHED
  TASK_EXTRACTED
  TASK_APPROVED
  TASK_COMPLETED
}

