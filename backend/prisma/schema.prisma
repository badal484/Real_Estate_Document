// Contingency Deadline Copilot — Prisma Schema
// Database: PostgreSQL 16
// Run: npx prisma migrate dev (dev) | npx prisma migrate deploy (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization / Multi-Tenancy Boundary ────────────────────────────────────
model Organization {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users               User[]
  leads               Lead[]
  properties          Property[]
  deals               Deal[]
  kbDocuments         KBDocument[]
  conversationThreads ConversationThread[]
  webhookEvents       WebhookEvent[]

  @@map("organizations")
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id             String        @id @default(cuid())
  googleId       String        @unique
  email          String        @unique
  name           String?
  pictureUrl     String?
  organizationId String?
  lastLoginAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id])
  assignedLeads Lead[]

  @@index([organizationId])
  @@map("users")
}

// ─── Lead & Lead Requirements ────────────────────────────────────────────────
model Lead {
  id             String       @id @default(cuid())
  organizationId String?
  source         LeadSource   @default(WEBSITE_FORM)
  externalId     String?
  fullName       String
  email          String?
  phone          String?
  status         LeadStatus   @default(NEW)
  priority       LeadPriority @default(MEDIUM)
  assignedUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization?              @relation(fields: [organizationId], references: [id])
  assignedUser  User?                      @relation(fields: [assignedUserId], references: [id])
  requirements  LeadRequirement?
  proposals     LeadRequirementProposal[]
  conversations ConversationThread[]
  matches       PropertyMatch[]
  deals         Deal[]

  @@index([organizationId, status])
  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([email, phone])
  @@map("leads")
}

enum LeadSource {
  WEBSITE_FORM
  PORTAL_INQUIRY
  WHATSAPP
  EMAIL
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model LeadRequirement {
  id                 String   @id @default(cuid())
  leadId             String   @unique
  minBudget          Float?
  maxBudget          Float?
  preferredLocations String[]
  propertyType       String?
  minBedrooms        Int?
  maxBedrooms        Int?
  possessionTimeline String?
  notes              String?  @db.Text
  rawAiExtraction    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_requirements")
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
}

model LeadRequirementProposal {
  id                  String         @id @default(cuid())
  leadId              String
  organizationId      String?
  proposedMinBudget   Float?
  proposedMaxBudget   Float?
  proposedLocations   String[]
  proposedPropertyType String?
  proposedMinBedrooms Int?
  proposedMaxBedrooms Int?
  proposedTimeline    String?
  confidence          Float?
  sourceMessageId     String?
  status              ProposalStatus @default(PENDING)
  createdAt           DateTime       @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
  @@index([organizationId])
  @@map("lead_requirement_proposals")
}

// ─── Multi-Channel Conversation & Controlled State Machine ───────────────────
enum ConversationState {
  AUTOPILOT
  DRAFT_ONLY
  HUMAN_TAKEOVER
  PAUSED
  CLOSED
}

model ConversationThread {
  id               String            @id @default(cuid())
  leadId           String
  organizationId   String?
  channel          MessageChannel    @default(EMAIL)
  state            ConversationState @default(AUTOPILOT)
  isHumanTakeover  Boolean           @default(false)
  takeoverBy       String?
  autoReplyEnabled Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lead         Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization?         @relation(fields: [organizationId], references: [id])
  messages     ConversationMessage[]

  @@index([leadId])
  @@index([organizationId])
  @@map("conversation_threads")
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  SMS
  WEB_CHAT
}

model ConversationMessage {
  id              String         @id @default(cuid())
  threadId        String
  organizationId  String?
  senderType      SenderType
  senderId        String?
  content         String         @db.Text
  suggestedAction Json?
  approvalStatus  ApprovalStatus @default(APPROVED)
  createdAt       DateTime       @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([organizationId])
  @@map("conversation_messages")
}

enum SenderType {
  CUSTOMER
  AGENT
  AI
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EDITED
}

// ─── Property Inventory & Matching ──────────────────────────────────────────
model Property {
  id             String         @id @default(cuid())
  organizationId String?
  title          String
  address        String
  city           String
  price          Float
  bedrooms       Int
  bathrooms      Float
  propertyType   String
  status         PropertyStatus @default(AVAILABLE)
  possessionDate DateTime?
  features       String[]
  description    String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization?   @relation(fields: [organizationId], references: [id])
  matches      PropertyMatch[]

  @@index([organizationId, price, bedrooms, status])
  @@map("properties")
}

enum PropertyStatus {
  AVAILABLE
  UNDER_CONTRACT
  SOLD
  OFF_MARKET
}

model PropertyMatch {
  id                     String   @id @default(cuid())
  leadId                 String
  propertyId             String
  organizationId         String?
  matchScore             Float
  aiExplanationConfidence Float?
  matchReason            String   @db.Text
  failedCriteria         String[]
  createdAt              DateTime @default(now())

  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([leadId, propertyId])
  @@index([organizationId])
  @@map("property_matches")
}

// ─── Transaction Tasks & Proposal Review Queue ──────────────────────────────
model TransactionTask {
  id               String     @id @default(cuid())
  dealId           String
  organizationId   String?
  title            String
  description      String?    @db.Text
  dueDate          DateTime
  amount           Float?
  assignedTo       String?
  isHumanReviewed  Boolean    @default(false)
  status           TaskStatus @default(PENDING)
  sourceDocumentId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, status])
  @@index([organizationId])
  @@map("transaction_tasks")
}

model TaskProposal {
  id              String         @id @default(cuid())
  dealId          String
  organizationId  String?
  sourceDocumentId String?
  title           String
  description     String?        @db.Text
  proposedDueDate DateTime
  proposedAmount  Float?
  sourceQuote     String?
  sourcePage      Int?
  confidence      Float?
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, status])
  @@index([organizationId])
  @@map("task_proposals")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

// ─── Webhook Event Logging & Idempotency ────────────────────────────────────
model WebhookEvent {
  id              String        @id @default(cuid())
  provider        String
  organizationId  String?
  externalEventId String
  eventType       String
  payload         Json
  status          String        @default("PENDING")
  error           String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([provider, externalEventId])
  @@index([organizationId, provider])
  @@map("webhook_events")
}

// ─── Knowledge Base Documents ────────────────────────────────────────────────
model KBDocument {
  id             String      @id @default(cuid())
  organizationId String?
  title          String
  category       String
  storagePath    String
  indexStatus    IndexStatus @default(PENDING)
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("kb_documents")
}

// ─── Deal ─────────────────────────────────────────────────────────────────────
model Deal {
  id               String      @id @default(cuid())
  organizationId   String?
  leadId           String?
  propertyAddress  String
  buyerName        String?
  sellerName       String?
  acceptanceDate   DateTime?
  status           DealStatus  @default(ACTIVE)
  timezone         String      @default("America/New_York")
  inboundAlias     String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization         Organization?           @relation(fields: [organizationId], references: [id])
  lead                 Lead?                   @relation(fields: [leadId], references: [id])
  documents            Document[]
  clauses              ContingencyClause[]
  deadlines            Deadline[]
  tasks                TransactionTask[]
  taskProposals        TaskProposal[]
  auditLogs            AuditLog[]
  chunks               DocumentChunk[]
  conversations        AssistantConversation[]
  notificationSettings NotificationSetting?
  emailLogs            EmailLog[]

  @@index([organizationId])
  @@map("deals")
}

enum DealStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

// ─── Document ─────────────────────────────────────────────────────────────────
model Document {
  id            String      @id @default(cuid())
  dealId        String
  organizationId String?
  filename      String
  storagePath   String
  mimeType      String      @default("application/pdf")
  sizeBytes     Int?
  docType       DocType     @default(OTHER)
  effectiveDate DateTime?
  pageCount     Int?
  indexStatus   IndexStatus @default(PENDING)
  indexedAt     DateTime?
  uploadedAt    DateTime    @default(now())

  deal    Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clauses ContingencyClause[]
  chunks  DocumentChunk[]

  @@index([dealId])
  @@index([organizationId])
  @@map("documents")
}

enum DocType {
  PURCHASE_AGREEMENT
  COUNTER_OFFER
  ADDENDUM
  INSPECTION_REPORT
  HOA_DISCLOSURE
  TITLE_COMMITMENT
  OTHER
}

enum IndexStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

// ─── DocumentChunk ────────────────────────────────────────────────────────────
model DocumentChunk {
  id           String      @id @default(cuid())
  documentId   String
  dealId       String
  organizationId String?
  pageNumber   Int
  chunkIndex   Int
  sectionTitle String?
  content      String      @db.Text
  tokenCount   Int?
  source       ChunkSource @default(text)
  embedding    Json?
  createdAt    DateTime    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, documentId])
  @@index([dealId, pageNumber])
  @@index([organizationId])
  @@map("document_chunks")
}

enum ChunkSource {
  text
  ocr
}

// ─── AssistantConversation & Messages ─────────────────────────────────────────
model AssistantConversation {
  id             String             @id @default(cuid())
  dealId         String
  organizationId String?
  userId         String?
  title          String             @default("New Conversation")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  deal     Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([dealId])
  @@index([organizationId])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id                 String                @id @default(cuid())
  conversationId     String
  organizationId     String?
  role               String
  content            String                @db.Text
  citations          Json?
  suggestedFollowUps Json?
  createdAt          DateTime              @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([organizationId])
  @@map("assistant_messages")
}

// ─── NotificationSetting & EmailLog ───────────────────────────────────────────
model NotificationSetting {
  id           String   @id @default(cuid())
  dealId       String   @unique
  organizationId String?
  recipients   Json
  window3d     Boolean  @default(true)
  window1d     Boolean  @default(true)
  windowDayOf  Boolean  @default(true)
  windowMissed Boolean  @default(true)
  enabled      Boolean  @default(true)
  timezone     String   @default("America/New_York")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notification_settings")
}

model EmailLog {
  id                String      @id @default(cuid())
  dealId            String
  organizationId    String?
  deadlineId        String?
  recipient         String
  template          String
  status            EmailStatus @default(SENT)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime    @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([deadlineId, template])
  @@index([dealId])
  @@index([organizationId])
  @@map("email_logs")
}

enum EmailStatus {
  SENT
  DELIVERED
  BOUNCED
  DROPPED
}

// ─── ContingencyClause ────────────────────────────────────────────────────────
model ContingencyClause {
  id           String      @id @default(cuid())
  dealId       String
  documentId   String
  organizationId String?
  clauseType   String
  rawText      String      @db.Text
  pageNumber   Int?
  boundingBox  Json?
  confidence   Float?
  numberOfDays Int?
  dayType      DayType?
  createdAt    DateTime    @default(now())

  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deadline Deadline?

  @@index([organizationId])
  @@map("contingency_clauses")
}

enum DayType {
  calendar
  business
}

// ─── Deadline ─────────────────────────────────────────────────────────────────
model Deadline {
  id             String         @id @default(cuid())
  dealId         String
  organizationId String?
  clauseId       String         @unique
  label          String
  computedDate   DateTime
  confirmedDate  DateTime?
  dayType        DayType        @default(calendar)
  status         DeadlineStatus @default(PENDING)
  confirmedBy    String?
  confirmedAt    DateTime?
  alertSentAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deal   Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clause ContingencyClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("deadlines")
}

enum DeadlineStatus {
  PENDING
  CONFIRMED
  ACTIVE
  MISSED
  COMPLETED
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────
model AuditLog {
  id             String      @id @default(cuid())
  dealId         String?
  organizationId String?
  action         AuditAction
  entityType     String?
  entityId       String?
  previousValue  Json?
  newValue       Json?
  actor          String?
  note           String?
  createdAt      DateTime    @default(now())

  deal Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("audit_logs")
}

enum AuditAction {
  DOCUMENT_UPLOADED
  EXTRACTION_STARTED
  EXTRACTION_COMPLETED
  DEADLINE_CONFIRMED
  DEADLINE_EDITED
  DEADLINE_ACTIVATED
  ALERT_SENT
  DEAL_CREATED
  DEAL_UPDATED
  ASSISTANT_QUERY
  DOCUMENT_INDEXED
  EMAIL_SENT_TEST
  EMAIL_INBOUND_RECEIVED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_REQUIREMENTS_EXTRACTED
  HUMAN_TAKEOVER_TOGGLED
  PROPERTY_CREATED
  PROPERTY_MATCHED
  TASK_EXTRACTED
  TASK_APPROVED
  TASK_COMPLETED
}
