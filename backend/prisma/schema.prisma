// Contingency Deadline Copilot — Prisma Schema
// Database: PostgreSQL 16
// Run: npx prisma db push  (dev)  |  npx prisma migrate deploy  (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ─────────────────────────────────────────────────────────────────────
// An agent who signs in with Google.
model User {
  id          String   @id @default(cuid())
  googleId    String   @unique
  email       String   @unique
  name        String?
  pictureUrl  String?
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

// ─── Deal ─────────────────────────────────────────────────────────────────────
// One Deal = one purchase agreement (one contract file).
model Deal {
  id               String      @id @default(cuid())
  propertyAddress  String
  buyerName        String?
  sellerName       String?
  acceptanceDate   DateTime?   // Contract acceptance / effective date
  status           DealStatus  @default(ACTIVE)
  timezone         String      @default("America/New_York") // [Person A]
  inboundAlias     String?     @unique                      // [Person A] e.g. "deal-abc123"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  documents            Document[]
  clauses              ContingencyClause[]
  deadlines            Deadline[]
  auditLogs            AuditLog[]
  chunks               DocumentChunk[]         // [Person B]
  conversations        AssistantConversation[] // [Person B]
  notificationSettings NotificationSetting?   // [Person A]
  emailLogs            EmailLog[]              // [Person A]

  @@map("deals")
}

enum DealStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

// ─── Document ─────────────────────────────────────────────────────────────────
// Uploaded PDF (or future: other doc types).
model Document {
  id            String         @id @default(cuid())
  dealId        String
  filename      String                     // original filename
  storagePath   String                     // local path or S3/ImageKit key
  mimeType      String         @default("application/pdf")
  sizeBytes     Int?
  docType       DocType        @default(OTHER)      // [Person B]
  effectiveDate DateTime?                           // [Person B]
  pageCount     Int?                                // [Person B]
  indexStatus   IndexStatus    @default(PENDING)    // [Person B] PENDING | INDEXING | READY | FAILED
  indexedAt     DateTime?                           // [Person B]
  uploadedAt    DateTime       @default(now())

  deal    Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clauses ContingencyClause[]
  chunks  DocumentChunk[]     // [Person B]

  @@map("documents")
}

enum DocType {
  PURCHASE_AGREEMENT
  COUNTER_OFFER
  ADDENDUM
  INSPECTION_REPORT
  HOA_DISCLOSURE
  TITLE_COMMITMENT
  OTHER
}

enum IndexStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

// ─── DocumentChunk ────────────────────────────────────────────────────────────
// [Person B] Page-level & section-boundary chunks with spatial/text metadata for RAG
model DocumentChunk {
  id           String      @id @default(cuid())
  documentId   String
  dealId       String
  pageNumber   Int
  chunkIndex   Int
  sectionTitle String?
  content      String      @db.Text
  tokenCount   Int?
  source       ChunkSource @default(text) // text layer or ocr fallback
  embedding    Json?                      // Array of floats or pgvector compatibility
  createdAt    DateTime    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, documentId])
  @@index([dealId, pageNumber])
  @@map("document_chunks")
}

enum ChunkSource {
  text
  ocr
}

// ─── AssistantConversation & Messages ─────────────────────────────────────────
// [Person B] Conversation threads for the AI Knowledge Assistant
model AssistantConversation {
  id        String             @id @default(cuid())
  dealId    String
  userId    String?
  title     String             @default("New Conversation")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  deal     Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([dealId])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id                 String                @id @default(cuid())
  conversationId     String
  role               String                // "user" | "assistant"
  content            String                @db.Text
  citations          Json?                 // Array of Citation objects
  suggestedFollowUps Json?                 // Array of string follow-ups
  createdAt          DateTime              @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("assistant_messages")
}

// ─── NotificationSetting & EmailLog ───────────────────────────────────────────
// [Person A Block] Email alert configurations & audit logs
model NotificationSetting {
  id          String   @id @default(cuid())
  dealId      String   @unique
  recipients  Json     // string[] email addresses
  window3d    Boolean  @default(true)
  window1d    Boolean  @default(true)
  windowDayOf Boolean  @default(true)
  windowMissed Boolean @default(true)
  enabled     Boolean  @default(true)
  timezone    String   @default("America/New_York")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model EmailLog {
  id                 String      @id @default(cuid())
  dealId             String
  deadlineId         String?
  recipient          String
  template           String      // "3d" | "1d" | "dayOf" | "missed" | "summary" | "docs_received"
  status             EmailStatus @default(SENT) // SENT | DELIVERED | BOUNCED | DROPPED
  providerMessageId  String?
  errorMessage       String?
  sentAt             DateTime    @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([deadlineId, template])
  @@index([dealId])
  @@map("email_logs")
}

enum EmailStatus {
  SENT
  DELIVERED
  BOUNCED
  DROPPED
}

// ─── ContingencyClause ────────────────────────────────────────────────────────
// A single extracted contingency from the PDF, with source evidence.
model ContingencyClause {
  id           String      @id @default(cuid())
  dealId       String
  documentId   String
  clauseType   String      // e.g. "inspection", "financing", "appraisal"
  rawText      String      @db.Text // exact quoted text from PDF
  pageNumber   Int?
  boundingBox  Json?       // { x, y, width, height } for pdf.js highlight
  confidence   Float?      // 0.0–1.0 from AI extraction
  numberOfDays Int?        // parsed: "X days"
  dayType      DayType?    // calendar | business
  createdAt    DateTime    @default(now())

  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deadline  Deadline?

  @@map("contingency_clauses")
}

enum DayType {
  calendar
  business
}

// ─── Deadline ─────────────────────────────────────────────────────────────────
// A computed (then user-confirmed) deadline derived from a clause.
model Deadline {
  id             String         @id @default(cuid())
  dealId         String
  clauseId       String         @unique    // one clause → one deadline
  label          String                    // human-readable: "Inspection Contingency"
  computedDate   DateTime                  // calculated by date engine
  confirmedDate  DateTime?                 // set when user confirms or edits
  dayType        DayType        @default(calendar)
  status         DeadlineStatus @default(PENDING)
  confirmedBy    String?                   // user identifier (email or name)
  confirmedAt    DateTime?
  alertSentAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deal   Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clause ContingencyClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@map("deadlines")
}

enum DeadlineStatus {
  PENDING    // extracted, not yet confirmed by user
  CONFIRMED  // user confirmed the date
  ACTIVE     // confirmed + alerts scheduled
  MISSED     // past due date, not completed
  COMPLETED  // agent marked as done
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────
// Immutable log of every extraction, confirmation, edit, or alert event.
model AuditLog {
  id            String      @id @default(cuid())
  dealId        String
  action        AuditAction
  entityType    String?     // "Deadline" | "ContingencyClause" | "Deal" | "Document" | "Assistant"
  entityId      String?
  previousValue Json?       // before-state snapshot
  newValue      Json?       // after-state snapshot
  actor         String?     // "system" | user email/name
  note          String?     // free-text annotation
  createdAt     DateTime    @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

enum AuditAction {
  DOCUMENT_UPLOADED
  EXTRACTION_STARTED
  EXTRACTION_COMPLETED
  DEADLINE_CONFIRMED
  DEADLINE_EDITED
  DEADLINE_ACTIVATED
  ALERT_SENT
  DEAL_CREATED
  DEAL_UPDATED
  ASSISTANT_QUERY          // [Person B]
  DOCUMENT_INDEXED         // [Person B]
  EMAIL_SENT_TEST          // [Person A]
  EMAIL_INBOUND_RECEIVED   // [Person A]
}
